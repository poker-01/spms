<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.spms.mapper.CommunityInfoMapper">

    <resultMap id="BaseResultMap" type="com.example.spms.model.po.CommunityInfo">
        <id property="id" column="id" />
        <result property="communityCode" column="community_code" />
        <result property="communityName" column="community_name" />
        <result property="address" column="address" />
        <result property="province" column="province" />
        <result property="city" column="city" />
        <result property="district" column="district" />
        <result property="totalBuildings" column="total_buildings" />
        <result property="totalUnits" column="total_units" />
        <result property="propertyCompany" column="property_company" />
        <result property="managerName" column="manager_name" />
        <result property="managerPhone" column="manager_phone" />
        <result property="status" column="status" />
        <result property="isDeleted" column="is_deleted" />
        <result property="version" column="version" />
        <result property="createTime" column="create_time" />
        <result property="updateTime" column="update_time" />
        <result property="createUser" column="create_user" />
        <result property="updateUser" column="update_user" />
    </resultMap>

    <!-- 扩展 ResultMap：带楼栋数和房屋数 -->
    <resultMap id="WithCountResultMap" type="com.example.spms.model.po.CommunityInfo" extends="BaseResultMap">
        <result property="totalBuildings" column="building_count" />
    </resultMap>

    <sql id="Base_Column_List">
        id,community_code,community_name,address,province,city,
        district,total_buildings,total_units,property_company,manager_name,
        manager_phone,status,is_deleted,version,create_time,
        update_time,create_user,update_user
    </sql>

    <!-- 分页查询小区（带条件） -->
    <select id="selectPageByCondition" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM community_info
        <where>
            is_deleted = 0
            <if test="communityName != null and communityName != ''">
                AND community_name LIKE CONCAT('%', #{communityName}, '%')
            </if>
            <if test="city != null and city != ''">
                AND city = #{city}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <!-- 查询小区及其楼栋数量、房屋数量 -->
    <select id="selectWithBuildingCount" resultType="java.util.HashMap">
        SELECT
            c.id,
            c.community_code,
            c.community_name,
            c.address,
            c.city,
            c.status,
            (SELECT COUNT(*) FROM building_info WHERE community_id = c.id AND is_deleted = 0) AS building_count,
            (SELECT COUNT(*) FROM house_info h
                                      INNER JOIN building_info b ON h.building_id = b.id
             WHERE b.community_id = c.id AND h.is_deleted = 0) AS house_count,
            (SELECT COUNT(*) FROM owner_house_rel r
                                      INNER JOIN house_info h ON r.house_info_id = h.id
                                      INNER JOIN building_info b ON h.building_id = b.id
             WHERE b.community_id = c.id AND r.is_deleted = 0) AS owner_count
        FROM community_info c
        WHERE c.is_deleted = 0
        ORDER BY c.create_time DESC
    </select>

</mapper>