<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.spms.mapper.OwnerInfoMapper">

    <resultMap id="BaseResultMap" type="com.example.spms.model.po.OwnerInfo">
        <id property="id" column="id" />
        <result property="ownerName" column="owner_name" />
        <result property="ownerPhone" column="owner_phone" />
        <result property="idCard" column="id_card" />
        <result property="gender" column="gender" />
        <result property="email" column="email" />
        <result property="status" column="status" />
        <result property="isDeleted" column="is_deleted" />
        <result property="version" column="version" />
        <result property="createTime" column="create_time" />
        <result property="updateTime" column="update_time" />
        <result property="createUser" column="create_user" />
        <result property="updateUser" column="update_user" />
    </resultMap>

    <!-- 扩展 ResultMap：带房屋集合 -->
    <resultMap id="WithHouseResultMap" type="com.example.spms.model.po.OwnerInfo" extends="BaseResultMap">
        <collection property="houses" ofType="java.util.HashMap">
            <id column="house_id" property="id"/>
            <result column="house_number" property="houseNumber"/>
            <result column="building_name" property="buildingName"/>
            <result column="community_name" property="communityName"/>
            <result column="relation_type" property="relationType"/>
            <result column="is_primary" property="isPrimary"/>
            <result column="house_area" property="houseArea"/>
        </collection>
    </resultMap>

    <sql id="Base_Column_List">
        id,owner_name,owner_phone,id_card,gender,email,
        status,is_deleted,version,create_time,update_time,
        create_user,update_user
    </sql>

    <!-- 分页查询业主（带条件） -->
    <select id="selectPageByCondition" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM owner_info
        <where>
            is_deleted = 0
            <if test="ownerName != null and ownerName != ''">
                AND owner_name LIKE CONCAT('%', #{ownerName}, '%')
            </if>
            <if test="ownerPhone != null and ownerPhone != ''">
                AND owner_phone LIKE CONCAT('%', #{ownerPhone}, '%')
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <!-- 查询业主详情（含关联房屋） -->
    <select id="selectDetailById" resultMap="WithHouseResultMap">
        SELECT
            o.id,
            o.owner_name,
            o.owner_phone,
            o.id_card,
            o.gender,
            o.email,
            o.status,
            o.is_deleted,
            o.version,
            o.create_time,
            o.update_time,
            o.create_user,
            o.update_user,
            h.id AS house_id,
            h.house_number,
            h.house_area,
            b.building_name,
            c.community_name,
            r.relation_type,
            r.is_primary
        FROM owner_info o
                 LEFT JOIN owner_house_rel r ON o.id = r.owner_info_id AND r.is_deleted = 0
                 LEFT JOIN house_info h ON r.house_info_id = h.id AND h.is_deleted = 0
                 LEFT JOIN building_info b ON h.building_id = b.id AND b.is_deleted = 0
                 LEFT JOIN community_info c ON b.community_id = c.id AND c.is_deleted = 0
        WHERE o.id = #{ownerId} AND o.is_deleted = 0
        ORDER BY r.is_primary DESC, r.create_time ASC
    </select>

    <!-- 根据房屋ID查询主要业主 -->
    <select id="selectByHouseId" resultMap="BaseResultMap">
        SELECT o.id,
               o.owner_name,
               o.owner_phone,
               o.id_card,
               o.gender,
               o.email,
               o.status,
               o.is_deleted,
               o.version,
               o.create_time,
               o.update_time,
               o.create_user,
               o.update_user
        FROM owner_info o
                 INNER JOIN owner_house_rel r ON o.id = r.owner_info_id
        WHERE r.house_info_id = #{houseId}
          AND r.is_primary = 1
          AND r.is_deleted = 0
          AND o.is_deleted = 0
          AND o.status = 1
            LIMIT 1
    </select>

</mapper>