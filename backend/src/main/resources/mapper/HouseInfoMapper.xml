<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.spms.mapper.HouseInfoMapper">

    <resultMap id="BaseResultMap" type="com.example.spms.model.po.HouseInfo">
        <id property="id" column="id" />
        <result property="buildingId" column="building_id" />
        <result property="houseNumber" column="house_number" />
        <result property="floorNumber" column="floor_number" />
        <result property="houseArea" column="house_area" />
        <result property="houseType" column="house_type" />
        <result property="ownerName" column="owner_name" />
        <result property="ownerPhone" column="owner_phone" />
        <result property="status" column="status" />
        <result property="isDeleted" column="is_deleted" />
        <result property="version" column="version" />
        <result property="createTime" column="create_time" />
        <result property="updateTime" column="update_time" />
        <result property="createUser" column="create_user" />
        <result property="updateUser" column="update_user" />
    </resultMap>

    <!-- 扩展 ResultMap：带楼栋名称和小区名称 -->
    <resultMap id="WithBuildingResultMap" type="com.example.spms.model.po.HouseInfo" extends="BaseResultMap">
        <result column="building_name" property="buildingName" />
        <result column="community_name" property="communityName" />
        <result column="community_id" property="communityId" />
    </resultMap>

    <sql id="Base_Column_List">
        id,building_id,house_number,floor_number,house_area,house_type,
        owner_name,owner_phone,status,is_deleted,version,
        create_time,update_time,create_user,update_user
    </sql>

    <!-- 分页查询房屋（带条件） -->
    <select id="selectPageByCondition" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM house_info
        <where>
            is_deleted = 0
            <if test="buildingId != null">
                AND building_id = #{buildingId}
            </if>
            <if test="houseNumber != null and houseNumber != ''">
                AND house_number LIKE CONCAT('%', #{houseNumber}, '%')
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY building_id, house_number
    </select>

    <!-- 查询房屋带楼栋和小区信息 -->
    <select id="selectWithBuildingInfo" resultMap="WithBuildingResultMap">
        SELECT
        h.id,
        h.building_id,
        h.house_number,
        h.floor_number,
        h.house_area,
        h.house_type,
        h.owner_name,
        h.owner_phone,
        h.status,
        h.is_deleted,
        h.version,
        h.create_time,
        h.update_time,
        h.create_user,
        h.update_user,
        b.building_name,
        b.community_id,
        c.community_name
        FROM house_info h
        LEFT JOIN building_info b ON h.building_id = b.id
        LEFT JOIN community_info c ON b.community_id = c.id
        <where>
            h.is_deleted = 0
            <if test="buildingId != null">
                AND h.building_id = #{buildingId}
            </if>
            <if test="ownerId != null">
                AND EXISTS (
                SELECT 1 FROM owner_house_rel r
                WHERE r.house_info_id = h.id
                AND r.owner_info_id = #{ownerId}
                AND r.is_deleted = 0
                )
            </if>
        </where>
        ORDER BY h.building_id, h.house_number
    </select>

    <!-- 统计各状态房屋数量 -->
    <select id="countByStatus" resultType="java.util.HashMap">
        SELECT
        CASE status
        WHEN 0 THEN '空置'
        WHEN 1 THEN '已入住'
        WHEN 2 THEN '已售未住'
        ELSE '未知'
        END AS status_name,
        status,
        COUNT(*) AS count
        FROM house_info
        WHERE is_deleted = 0
        <if test="buildingId != null">
            AND building_id = #{buildingId}
        </if>
        GROUP BY status
        ORDER BY status
    </select>

</mapper>